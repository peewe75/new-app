# --- Studio ---
SEGUITO_STUDIO_NAME="Studio Legale Sapone"
SEGUITO_LAWYER_NAME="Avv. Vincenzo Sapone"
SEGUITO_LAWYER_EMAIL=avvocato@studio.example
# Casella che riceve le trascrizioni
SEGUITO_STUDIO_EMAIL=segreteria@studio.example
SEGUITO_TIMEZONE=Europe/Rome
# Link di prenotazione per gli appuntamenti "da fissare" (es. Cal.com)
SEGUITO_BOOKING_LINK=
# Firma email (usa \n per andare a capo)
SEGUITO_SIGNATURE="Avv. Vincenzo Sapone\nStudio Legale Sapone"

# --- Analisi con Claude ---
ANTHROPIC_API_KEY=
SEGUITO_CLAUDE_MODEL=claude-opus-5-5
SEGUITO_CLAUDE_EFFORT=high
# Limite di token in uscita per ogni analisi (aumentarlo per registrazioni molto lunghe)
SEGUITO_CLAUDE_MAX_TOKENS=16000

# --- Plaud (dopo `npx @plaud-ai/cli login`) ---
PLAUD_TOKENS_PATH=~/.plaud/tokens.json
# PLAUD_REGION=

# --- Microsoft 365 (eventi in Outlook e bozze; vedi docs/microsoft365-setup.md) ---
# Senza questi tre valori Seguito produce file .ics ed .eml nella cartella outbox
SEGUITO_M365_TENANT_ID=
SEGUITO_M365_CLIENT_ID=
SEGUITO_M365_CLIENT_SECRET=
# Deve coincidere con l'URI di reindirizzamento registrato in Microsoft Entra
# SEGUITO_M365_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
# SEGUITO_M365_TOKENS_FILE=./data/microsoft365.json
# Trascrizione alla casella dello studio: bozza (predefinito) oppure invio
# SEGUITO_TRASCRIZIONE=bozza

# --- App ---
SEGUITO_HOST=127.0.0.1
SEGUITO_PORT=3000
# Nomi (separati da virgole) con cui si apre l'interfaccia da altri dispositivi;
# indirizzi IP e localhost sono sempre accettati
SEGUITO_ALLOWED_HOSTS=
# Se impostata, l'interfaccia chiede utente "studio" e questa password
SEGUITO_PASSWORD=
SEGUITO_DATA_DIR=./data
SEGUITO_OUTBOX_DIR=./outbox
SEGUITO_GESTIONALE_FILE=./data/gestionale.json
